# ==============================================================================
# OMNIVA PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env.local` or `.env` and supply environment-specific credentials.
# DO NOT commit real secrets or credentials to Git.
# ==============================================================================

# ─── 1. DATABASE CONFIGURATION (POSTGRESQL >= 15) ─────────────────────────────
# Dedicated OMNIVA database instance (must NOT share or connect to AVANI databases)
DATABASE_URL="postgresql://omniva_user:password@localhost:5432/omniva_db?schema=public"

# ─── 2. AUTHENTICATION & SESSIONS (NEXTAUTH / AUTH.JS) ────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-secret-min-32-chars"
AUTH_SECRET="replace-with-a-secure-random-secret-min-32-chars"

# ─── 3. OAUTH PROVIDERS (OPTIONAL FOR PREVIEW, REQUIRED FOR PROD) ─────────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ─── 4. META & WHATSAPP CLOUD API ─────────────────────────────────────────────
META_APP_ID=""
META_APP_SECRET=""
META_SYSTEM_USER_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# ─── 5. ARTIFICIAL INTELLIGENCE & LLM PROVIDERS ───────────────────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_DEFAULT_MODEL="gpt-4o"

# ─── 6. VOICE PIPELINE (STREAMING SYNTHESIS & TRANSCRIPTION) ──────────────────
ELEVENLABS_API_KEY=""
DEEPGRAM_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ─── 7. BILLING & PAYMENTS (STRIPE — PHASE 9) ─────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── 8. OBJECT STORAGE (S3 COMPATIBLE / CLOUDFLARE R2 / AWS) ──────────────────
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET="omniva-assets"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# ─── 9. CACHE & ASYNC QUEUES (UPSTASH REDIS) ─────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── 10. TRANSACTIONAL EMAIL (RESEND / SMTP) ──────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="OMNIVA Notifications <notifications@omniva.ai>"

# ─── 11. GENERAL APPLICATION SETTINGS ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
